<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <PackageId>Snail.Toolkit.Redis</PackageId>
        <PackageTags>StackExchange.Redis;Redis;cache;distributed-cache;pubsub;streaming</PackageTags>
        <Title>Snail.Toolkit.Redis</Title>
        <Authors>orldev</Authors>
        <Description>Redis extensions over StackExchange.Redis: one shared IConnectionMultiplexer, ICacheService (System.Text.Json distributed cache with fallback factory) and IRedisPubSub (typed publish and IAsyncEnumerable subscription).</Description>
        <RepositoryUrl>https://github.com/orldev/Snail.Toolkit.Redis</RepositoryUrl>
        <Copyright>Toolkit, 2023-2026</Copyright>
        <PackageProjectUrl>https://github.com/orldev/Snail.Toolkit.Redis</PackageProjectUrl>
        <RepositoryType>GitHub</RepositoryType>
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
    </PropertyGroup>

    <ItemGroup>
        <None Include="..\README.md" Pack="true" PackagePath="\"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.Caching.StackExchangeRedis" Version="10.0.11" />
        <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks" Version="10.0.11" />
        <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.11" />
        <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.11" />
        <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.11" />
    </ItemGroup>

</Project>
