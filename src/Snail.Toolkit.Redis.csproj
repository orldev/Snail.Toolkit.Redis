<Project Sdk="Snail.Sdk.Library">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <EnableConfigurationBindingGenerator>true</EnableConfigurationBindingGenerator>
        <PackageId>Snail.Toolkit.Redis</PackageId>
        <PackageTags>StackExchange.Redis;Redis;cache;distributed-cache;pubsub;streaming</PackageTags>
        <Title>Snail.Toolkit.Redis</Title>
        <Authors>orldev</Authors>
        <Description>Redis extensions over StackExchange.Redis: one shared IConnectionMultiplexer, IRedisCache (System.Text.Json cache with a fallback factory), IRedisPubSub (typed publish and IAsyncEnumerable subscriptions) and IRedisStream (append-only history a late reader catches up on).</Description>
        <RepositoryUrl>https://github.com/orldev/Snail.Toolkit.Redis</RepositoryUrl>
        <Copyright>Toolkit, 2023-2026</Copyright>
        <PackageProjectUrl>https://github.com/orldev/Snail.Toolkit.Redis</PackageProjectUrl>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
    </PropertyGroup>

    <ItemGroup>
        <None Include="..\README.md" Pack="true" PackagePath="\"/>
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Snail.Toolkit.Redis.Tests" />
        <InternalsVisibleTo Include="Snail.Toolkit.Redis.Benchmarks" />
        <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.Caching.StackExchangeRedis" />
        <PackageReference Include="Microsoft.Extensions.Configuration" />
        <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks" />
        <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
        <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
        <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
    </ItemGroup>

</Project>
